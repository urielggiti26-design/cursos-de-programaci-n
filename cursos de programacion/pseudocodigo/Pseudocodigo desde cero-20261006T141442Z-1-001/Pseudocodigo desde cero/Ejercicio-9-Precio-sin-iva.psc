//el iva es del 21%
//calcular el precio antes de impuestos 
Algoritmo Ejercicio9_precio_sin_iva
    Definir precioVenta, precioSinIva Como Real;
    Escribir "Ingrese el precio de venta (con IVA): " Sin Saltar;
    Leer precioVenta;
    precioSinIva <- precioVenta / 1.21;
    Escribir "El precio antes de impuestos es: ", precioSinIva;
	
FinAlgoritmo