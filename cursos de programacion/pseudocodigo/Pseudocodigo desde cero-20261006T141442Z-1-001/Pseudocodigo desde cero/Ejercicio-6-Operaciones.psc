//pide al usuario dos numeros.
//debes sumar, restar
//debes multiplicar, dicvidir.
//elevar el primer numero a la potencia del segundo.
//el resto que resulte de dividir el primero entre el segundo.
Algoritmo Operaciones
	Definir num1, num2 Como Real;
	Escribir "Ingrese el primer numero " Sin Saltar;
	Leer num1;
	Escribir "Ingrese el segundo numero " Sin Saltar;
	Leer num2;
	Escribir "Suma: ", num1+num2;
	Escribir "Resta: ", num1-num2;
	Escribir "Multiplicacion: ", num1*num2;
	Escribir "Division: ", num1/num2;
	Escribir "Potencia: ", num1^num2;
	Escribir "Resto: ", num1%num2;
	
FinAlgoritmo
