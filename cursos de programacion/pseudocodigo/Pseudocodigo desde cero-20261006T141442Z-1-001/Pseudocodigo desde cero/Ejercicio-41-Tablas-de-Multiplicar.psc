//mostrar las tablas de multiplicar del 1 al 10
//un bucle para la tabla y otro bucle dentro para multiplicar del 1 al 10
Algoritmo Ejercicio41_Tablas_de_Multiplicar
    Definir i, j Como Entero;
    Para i <- 1 Hasta 10 Hacer
        Escribir "Tabla del ", i;
        Para j <- 1 Hasta 10 Hacer
            Escribir i, " x ", j, " = ", i * j;
        FinPara
        Escribir "";
    FinPara
FinAlgoritmo
