Algoritmo Ejercicio_12_Positivo_o_Negativo
	Definir numero como real;
	Escribir "Ingrese un numero. " Sin Saltar;
	Leer numero;
	Si numero > 0 Entonces
		Escribir "El numero es positivo ";
	SiNo
		Si numero < 0 Entonces
			Escribir "El numero es negativo ";
			
		FinSi
	FinSi
	
FinAlgoritmo
